{
  "name": "cinemalove-qt6",
  "private": true,
  "version": "0.1.0",
  "description": "CinemaLove (Qt 6 + libmpv). Los scripts solo envuelven a PowerShell/CMake.",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -DebugBuild",
    "configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1 -Configure",
    "fetch:libmpv": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-libmpv.ps1"
  }
}
